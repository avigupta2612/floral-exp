<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FLORA // ETERNAL BLOOM — Interactive 3D Botanical Experience</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Cormorant Garamond, Inter, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <!-- Three.js r128 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- GSAP 3.12.2 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          }
        }
      }
    }
  </script>

  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #090d16;
      color: #f8fafc;
      font-family: 'Inter', sans-serif;
    }

    #webgl-container {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      cursor: grab;
    }
    #webgl-container:active {
      cursor: grabbing;
    }

    /* Glassmorphism surfaces */
    .glass-panel {
      background: rgba(12, 16, 26, 0.58);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }

    .glass-pill {
      background: rgba(15, 20, 32, 0.48);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .glass-pill:hover {
      background: rgba(255, 255, 255, 0.14);
      border-color: rgba(255, 255, 255, 0.28);
    }
    .glass-pill.active {
      background: linear-gradient(135deg, rgba(251, 191, 36, 0.28), rgba(244, 114, 182, 0.24));
      border-color: rgba(251, 191, 36, 0.65);
      color: #fef3c7;
      box-shadow: 0 0 20px rgba(251, 191, 36, 0.22);
    }

    /* Custom Range Sliders */
    input[type="range"].custom-slider {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.14);
      border-radius: 999px;
      outline: none;
      cursor: pointer;
    }
    input[type="range"].custom-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #fbbf24;
      border: 2px solid #fff;
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.85);
      cursor: pointer;
      transition: transform 0.15s ease, background-color 0.2s ease;
    }
    input[type="range"].custom-slider::-webkit-slider-thumb:hover {
      transform: scale(1.2);
      background: #fde68a;
    }
    input[type="range"].custom-slider::-moz-range-thumb {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: #fbbf24;
      border: 2px solid #fff;
      box-shadow: 0 0 12px rgba(251, 191, 36, 0.85);
      cursor: pointer;
      transition: transform 0.15s ease;
    }

    /* Subtle text glow */
    .hero-title-glow {
      text-shadow: 0 10px 35px rgba(0, 0, 0, 0.65), 0 0 60px rgba(251, 191, 36, 0.15);
    }

    /* Smooth transitions for hero overlay */
    .ui-transition {
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .ui-hidden {
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translateY(12px) scale(0.98);
    }

    /* Custom cursor ripple indicator */
    #wind-cursor-ring {
      position: fixed;
      width: 44px;
      height: 44px;
      border-radius: 9999px;
      border: 1px solid rgba(253, 230, 138, 0.35);
      background: radial-gradient(circle, rgba(253, 230, 138, 0.12) 0%, rgba(253, 230, 138, 0) 70%);
      pointer-events: none;
      z-index: 10;
      transform: translate(-50%, -50%);
      transition: width 0.2s ease, height 0.2s ease, border-color 0.2s ease;
      mix-blend-mode: screen;
    }
  </style>
</head>
