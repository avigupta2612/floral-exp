      // Time-of-Day Lighting Switcher
      const lightingBtns = document.querySelectorAll('.lighting-btn');
      lightingBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          lightingBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          state.lightingMode = btn.getAttribute('data-lighting');
        });
      });

      // Wind Intensity Slider & Romantic Petal Breeze Trigger
      const windSlider = document.getElementById('wind-slider');
      const windValLabel = document.getElementById('wind-value-label');
      const statWindVel = document.getElementById('stat-wind-vel');

      function updateWindLabel(val) {
        windValLabel.textContent = val.toFixed(1) + 'x';
        if (val < 0.6) statWindVel.textContent = 'Whisper';
        else if (val < 1.3) statWindVel.textContent = 'Tender';
        else if (val < 1.9) statWindVel.textContent = 'Sweeping';
        else statWindVel.textContent = 'Passionate';
      }

      windSlider.addEventListener('input', (e) => {
        const v = parseFloat(e.target.value);
        state.windStrength = v;
        updateWindLabel(v);
      });

      function triggerPollenGust(strength = 1.4) {
        gsap.fromTo(state,
          { windGustBoost: strength },
          { windGustBoost: 0.0, duration: 2.8, ease: 'power2.out' }
        );
        // Apply physical spring impulse to the hero stem & petals!
        heroSprings.stemBendZ.impulse(strength * 0.45);
        heroSprings.stemBendX.impulse((Math.random() - 0.5) * strength * 0.35);
        heroPetals.forEach((p) => {
          p.pitchSpring.impulse((Math.random() - 0.3) * 0.65 * strength);
          p.rollSpring.impulse((Math.random() - 0.5) * 0.45 * strength);
        });

        // Swirl pollen & floating rose petals upward
        for (let i = 0; i < pollenCount; i++) {
          pollenVelocities[i * 3] += (Math.random() - 0.3) * 0.9 * strength;
          pollenVelocities[i * 3 + 1] += (0.25 + Math.random() * 0.65) * strength;
          pollenVelocities[i * 3 + 2] += (Math.random() - 0.5) * 0.9 * strength;
        }
        for (let i = 0; i < floatingPetalCount; i++) {
          floatingPetalsData[i].vel.x += (0.4 + Math.random() * 0.8) * strength;
          floatingPetalsData[i].vel.y += (0.35 + Math.random() * 0.6) * strength;
        }
        if (state.audioEnabled) triggerHarmonicChord();
      }

      document.getElementById('btn-wind-gust').addEventListener('click', () => triggerPollenGust(1.65));

      // Exhibition UI Hide / Show Toggle
      const heroEditorialEl = document.getElementById('hero-editorial-overlay');
      const toggleUiBtn = document.getElementById('btn-toggle-ui');
      const toggleUiText = document.getElementById('toggle-ui-text');

      toggleUiBtn.addEventListener('click', () => {
        state.uiVisible = !state.uiVisible;
        if (state.uiVisible) {
          heroEditorialEl.classList.remove('ui-hidden');
          toggleUiBtn.classList.add('active');
          toggleUiText.textContent = 'Exhibition UI';
        } else {
          heroEditorialEl.classList.add('ui-hidden');
          toggleUiBtn.classList.remove('active');
          toggleUiText.textContent = 'Pure 3D Canvas';
        }
      });

      /* ==========================================================================
       * 14. INTERACTIVE CURSOR WIND RIPPLE, CLICK BLOOM WAVE & ORBIT DRAG
       * ========================================================================== */
      const cursorRing = document.getElementById('wind-cursor-ring');

      function handlePointerMove(clientX, clientY) {
        if (cursorRing) {
          cursorRing.style.left = clientX + 'px';
          cursorRing.style.top = clientY + 'px';
        }

        const nx = (clientX / window.innerWidth) * 2 - 1;
        const ny = -(clientY / window.innerHeight) * 2 + 1;
        state.pointerNDC.set(nx, ny);

        if (state.isDraggingOrbit) {
          const dx = nx - state.dragStart.x;
          const dy = ny - state.dragStart.y;
          if (Math.abs(dx) > 0.008 || Math.abs(dy) > 0.008) {
            state.dragMoved = true;
          }
          state.targetOrbitOffset.x = THREE.MathUtils.clamp(state.targetOrbitOffset.x + dx * 0.85, -1.6, 1.6);
          state.targetOrbitOffset.y = THREE.MathUtils.clamp(state.targetOrbitOffset.y + dy * 0.65, -0.8, 1.2);
          state.dragStart.set(nx, ny);
        }

        raycaster.setFromCamera(state.pointerNDC, camera);
        const hitPoint = new THREE.Vector3();
        if (raycaster.ray.intersectPlane(raycastPlane, hitPoint)) {
          hitPoint.y = getTerrainHeight(hitPoint.x, hitPoint.z) + 1.0;
          state.mouseWorldVel.subVectors(hitPoint, state.lastMouseWorldPos);
          state.lastMouseWorldPos.copy(hitPoint);
          state.mouseWorldPos.copy(hitPoint);
        }
      }

      window.addEventListener('mousemove', (e) => {
        handlePointerMove(e.clientX, e.clientY);
      });

      container.addEventListener('mousedown', (e) => {
        state.isDraggingOrbit = true;
        state.dragMoved = false;
        const nx = (e.clientX / window.innerWidth) * 2 - 1;
        const ny = -(e.clientY / window.innerHeight) * 2 + 1;
        state.dragStart.set(nx, ny);
        if (cursorRing) {
          cursorRing.style.width = '64px';
          cursorRing.style.height = '64px';
          cursorRing.style.borderColor = 'rgba(251, 113, 133, 0.85)';
        }
      });

      window.addEventListener('mouseup', () => {
        if (state.isDraggingOrbit && !state.dragMoved) {
          // Clicking without dragging triggers a romantic bloom ripple wave from the cursor point!
          state.clickWaveOrigin.copy(state.mouseWorldPos);
          state.clickWaveRadius = 0.2;
          state.clickWaveStrength = 1.35;
          heroSprings.stemBendZ.impulse(0.22);
          heroPetals.forEach((p) => p.pitchSpring.impulse((Math.random() - 0.3) * 0.35));
          if (state.audioEnabled) triggerHarmonicChord();
        }
        state.isDraggingOrbit = false;
        if (cursorRing) {
          cursorRing.style.width = '44px';
          cursorRing.style.height = '44px';
          cursorRing.style.borderColor = 'rgba(253, 230, 138, 0.35)';
        }
      });

      // Touch Support
      container.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          state.isDraggingOrbit = true;
          state.dragMoved = false;
          const t = e.touches[0];
          const nx = (t.clientX / window.innerWidth) * 2 - 1;
          const ny = -(t.clientY / window.innerHeight) * 2 + 1;
          state.dragStart.set(nx, ny);
          handlePointerMove(t.clientX, t.clientY);
        }
      }, { passive: true });

      container.addEventListener('touchmove', (e) => {
        if (e.touches.length === 1) {
          const t = e.touches[0];
          handlePointerMove(t.clientX, t.clientY);
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        state.isDraggingOrbit = false;
      });

      /* ==========================================================================
       * 15. PROCEDURAL WEB AUDIO BOTANICAL AMBIENT SYNTH (User-Triggered)
       * ========================================================================== */
      let audioCtx = null;
      let masterGain = null;

      function initProceduralAudio() {
        if (audioCtx) return;
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (!AudioContextClass) return;

        audioCtx = new AudioContextClass();
        masterGain = audioCtx.createGain();
        masterGain.gain.value = 0.14;
        masterGain.connect(audioCtx.destination);

        // Warm continuous harmonic drone (Fmaj9 botanical pad)
        const padFreqs = [174.61, 220.0, 261.63, 329.63, 392.0];
        padFreqs.forEach((f, idx) => {
          const osc = audioCtx.createOscillator();
          const oscGain = audioCtx.createGain();
          osc.type = idx % 2 === 0 ? 'sine' : 'triangle';
          osc.frequency.value = f;
          oscGain.gain.value = 0.08 / padFreqs.length;

          const filter = audioCtx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.value = 620;

          osc.connect(filter);
          filter.connect(oscGain);
          oscGain.connect(masterGain);
          osc.start();
        });
      }

      function triggerHarmonicChord() {
        if (!audioCtx || !state.audioEnabled) return;
        const notes = [523.25, 659.25, 783.99, 987.77, 1174.66];
        const now = audioCtx.currentTime;
        notes.forEach((freq, i) => {
          const osc = audioCtx.createOscillator();
          const g = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now + i * 0.09);

          g.gain.setValueAtTime(0.0001, now + i * 0.09);
          g.gain.linearRampToValueAtTime(0.06, now + i * 0.09 + 0.08);
          g.gain.exponentialRampToValueAtTime(0.0001, now + i * 0.09 + 2.4);

          osc.connect(g);
          g.connect(masterGain);
          osc.start(now + i * 0.09);
          osc.stop(now + i * 0.09 + 2.5);
        });
      }

      const btnAudio = document.getElementById('btn-audio-toggle');
      const iconAudioOff = document.getElementById('icon-audio-off');
      const iconAudioOn = document.getElementById('icon-audio-on');
      const audioStatusText = document.getElementById('audio-status-text');

      btnAudio.addEventListener('click', () => {
        initProceduralAudio();
        state.audioEnabled = !state.audioEnabled;
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        if (state.audioEnabled) {
          if (masterGain) gsap.to(masterGain.gain, { value: 0.18, duration: 0.8 });
          iconAudioOff.classList.add('hidden');
          iconAudioOn.classList.remove('hidden');
          btnAudio.classList.add('active');
          audioStatusText.textContent = 'Sound On';
          triggerHarmonicChord();
        } else {
          if (masterGain) gsap.to(masterGain.gain, { value: 0.0001, duration: 0.5 });
          iconAudioOff.classList.remove('hidden');
          iconAudioOn.classList.add('hidden');
          btnAudio.classList.remove('active');
          audioStatusText.textContent = 'Sound Off';
        }
      });

      /* ==========================================================================
       * 16. RESPONSIVE RESIZE HANDLER
       * ========================================================================== */
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        const pr = Math.min(window.devicePixelRatio, 2);
        renderer.setPixelRatio(pr);
        pollenMat.uniforms.uPixelRatio.value = pr;
      });

      /* ==========================================================================
       * 17. REAL-TIME ANIMATION LOOP (Pollen, Silk Petals, Physics & Render)
       * ========================================================================== */
      const clock = new THREE.Clock();

      function updateFloatingSilkPetals(dt, elapsedTime) {
        const totalWind = state.windStrength + state.windGustBoost;
        const mx = state.mouseWorldPos.x;
        const my = state.mouseWorldPos.y;
        const mz = state.mouseWorldPos.z;

        // Only release floating silk petals once the hero flower starts blooming
        const visibilityScale = THREE.MathUtils.smoothstep(state.bloomAmount, 0.1, 0.55);

        for (let i = 0; i < floatingPetalCount; i++) {
          const fp = floatingPetalsData[i];

          const flutterX = Math.sin(elapsedTime * 1.8 + fp.phase) * 0.45 * totalWind;
          const flutterZ = Math.cos(elapsedTime * 1.5 + fp.phase) * 0.35 * totalWind;

          fp.pos.x += (fp.vel.x + 0.38 * totalWind + flutterX) * dt;
          fp.pos.y += (fp.vel.y + Math.sin(elapsedTime * 2.4 + fp.phase) * 0.12) * dt;
          fp.pos.z += (fp.vel.z + flutterZ) * dt;

          fp.vel.x *= 0.96;
          fp.vel.y = THREE.MathUtils.lerp(fp.vel.y, -0.18, 0.03);
          fp.vel.z *= 0.96;

          // Cursor breeze swirl on floating petals
          const dx = fp.pos.x - mx;
          const dy = fp.pos.y - my;
          const dz = fp.pos.z - mz;
          const d2 = dx * dx + dy * dy + dz * dz;
          if (d2 < 16.0 && d2 > 0.01) {
            const d = Math.sqrt(d2);
            const push = (1.0 - d / 4.0) * 3.5 * dt;
            fp.pos.x += (dx / d) * push;
            fp.pos.y += Math.abs(push) * 0.85;
            fp.pos.z += (dz / d) * push;
          }

          fp.rot.x += fp.rotSpeed.x * dt * (0.7 + 0.5 * totalWind);
          fp.rot.y += fp.rotSpeed.y * dt * (0.7 + 0.5 * totalWind);
          fp.rot.z += fp.rotSpeed.z * dt * (0.7 + 0.5 * totalWind);

          const groundY = getTerrainHeight(fp.pos.x, fp.pos.z);
          if (fp.pos.y < groundY + 0.15 || fp.pos.x > 40 || fp.pos.y > groundY + 9.0) {
            if (i < 65) {
              // Respawn near the blooming hero flower crown
              const a = Math.random() * Math.PI * 2;
              const r = 0.15 + Math.random() * 0.8;
              fp.pos.set(Math.cos(a) * r, heroBaseY + 2.2 + Math.random() * 0.6, Math.sin(a) * r);
            } else {
              const a = Math.random() * Math.PI * 2;
              const r = 1.5 + Math.random() * 32.0;
              fp.pos.x = Math.cos(a) * r;
              fp.pos.z = Math.sin(a) * r;
              fp.pos.y = getTerrainHeight(fp.pos.x, fp.pos.z) + 3.5 + Math.random() * 4.0;
            }
          }

          petalDummy.position.copy(fp.pos);
          petalDummy.rotation.copy(fp.rot);
          petalDummy.scale.setScalar(fp.scale * visibilityScale);
          petalDummy.updateMatrix();
          floatingPetalInst.setMatrixAt(i, petalDummy.matrix);
        }
        floatingPetalInst.instanceMatrix.needsUpdate = true;
      }

      function updatePollenParticles(dt, elapsedTime) {
        const posAttr = pollenGeo.attributes.position;
        const posArr = posAttr.array;
        const totalWind = state.windStrength + state.windGustBoost;
        const mx = state.mouseWorldPos.x;
        const my = state.mouseWorldPos.y;
        const mz = state.mouseWorldPos.z;

        for (let i = 0; i < pollenCount; i++) {
          const idx = i * 3;
          let px = posArr[idx];
          let py = posArr[idx + 1];
          let pz = posArr[idx + 2];

          const swirlX = Math.sin(elapsedTime * 0.9 + py * 0.8 + i) * 0.22 * totalWind;
          const swirlZ = Math.cos(elapsedTime * 0.7 + px * 0.8 + i) * 0.22 * totalWind;

          px += (pollenVelocities[idx] + swirlX + 0.18 * totalWind) * dt;
          py += pollenVelocities[idx + 1] * dt;
          pz += (pollenVelocities[idx + 2] + swirlZ) * dt;

          pollenVelocities[idx] *= 0.96;
          pollenVelocities[idx + 1] = THREE.MathUtils.lerp(pollenVelocities[idx + 1], 0.12, 0.04);
          pollenVelocities[idx + 2] *= 0.96;

          const dx = px - mx;
          const dy = py - my;
          const dz = pz - mz;
          const distSq = dx * dx + dy * dy + dz * dz;
          if (distSq < 18.0 && distSq > 0.001) {
            const dist = Math.sqrt(distSq);
            const force = (1.0 - dist / 4.24) * 3.2 * dt;
            px += (dx / dist) * force + state.mouseWorldVel.x * 0.25;
            py += Math.abs(force) * 0.65;
            pz += (dz / dist) * force + state.mouseWorldVel.z * 0.25;
          }

          if (i < 350) {
            if (py > 4.6 || px * px + pz * pz > 16.0) {
              const ang = Math.random() * Math.PI * 2;
              const r = 0.08 + Math.random() * 0.65;
              px = Math.cos(ang) * r;
              py = 0.5 + state.stemGrowth * 1.85 + Math.random() * 0.35;
              pz = Math.sin(ang) * r;
            }
          } else {
            const groundY = getTerrainHeight(px, pz);
            if (py > groundY + 6.5 || Math.abs(px) > 55 || Math.abs(pz) > 55) {
              const ang = Math.random() * Math.PI * 2;
              const r = 1.5 + Math.random() * 44.0;
              px = Math.cos(ang) * r;
              pz = Math.sin(ang) * r;
              py = getTerrainHeight(px, pz) + 0.25;
            }
          }

          posArr[idx] = px;
          posArr[idx + 1] = py;
          posArr[idx + 2] = pz;
        }

        posAttr.needsUpdate = true;
        state.mouseWorldVel.multiplyScalar(0.85);
      }

      function animate() {
        requestAnimationFrame(animate);

        const dt = Math.min(clock.getDelta(), 0.05);
        const elapsedTime = clock.getElapsedTime();
        const effectiveWind = state.windStrength + state.windGustBoost;

        skyUniforms.uTime.value = elapsedTime;
        starMat.uniforms.uTime.value = elapsedTime;
        heroPetalUniforms.uTime.value = elapsedTime;
        heroPetalUniforms.uWindStrength.value = effectiveWind;
        meadowUniforms.uTime.value = elapsedTime;
        meadowUniforms.uWindStrength.value = effectiveWind;
        meadowUniforms.uMousePos.value.lerp(state.mouseWorldPos, 0.18);
        pollenMat.uniforms.uTime.value = elapsedTime;

        updateAtmosphere(dt);
        evaluateGrowthPhysicsAndCamera(state.timelineProgress, dt, elapsedTime);
        updateFloatingSilkPetals(dt, elapsedTime);
        updatePollenParticles(dt, elapsedTime);

        renderer.render(scene, camera);
      }

      animate();
    };
  </script>
</body>
